{
  "name": "magic-trims",
  "private": true,
  "description": "Table de jeu Magic: The Gathering Commander entre amis, jusqu'\u00e0 5 joueurs en ligne.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "host": "npm run host -w @magic-trims/host --",
    "app": "npm run dev -w @magic-trims/app",
    "dist": "npm run dist -w @magic-trims/app",
    "postinstall": "node scripts/install-electron.mjs",
    "precons": "tsx scripts/fetch-precons.ts",
    "central": "npm run central -w @magic-trims/central --",
    "central:deploy": "npm run deploy -w @magic-trims/central"
  },
  "engines": {
    "node": ">=20"
  }
}
